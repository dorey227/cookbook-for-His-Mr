  function parseQuantity(ingredient) {
    const match = ingredient.match(/^(\d+)\s*(g|kg|ml|l|oz|lb)?\s*(.+)/i);
    if (match) {
      return { quantity: parseFloat(match[1]), unit: match[2]?.toLowerCase() || '', name: match[3].trim() };
    }
    const countMatch = ingredient.match(/^(\d+)\s*(.+)/);
    if (countMatch) {
      return { quantity: parseFloat(countMatch[1]), unit: 'count', name: countMatch[2].trim() };
    }
    return { quantity: 100, unit: 'g', name: ingredient };
  }

  function autoCalculateMacros() {
    if (!tempIngredients.length) {
      autoProgress.textContent = '⚠️ Add ingredients first!';
      setTimeout(() => { autoProgress.textContent = ''; }, 3000);
      return;
    }

    autoProgress.textContent = '🔍 Analyzing...';
    setTimeout(() => {
      let totalCal = 0, totalProtein = 0, totalCarbs = 0, totalFat = 0;
      let matched = 0;

      tempIngredients.forEach(ing => {
        const parsed = parseQuantity(ing);
        const name = parsed.name.toLowerCase();
        let found = false;

        if (specialItems[name] || specialItems[name.replace(/s$/, '')]) {
          const key = name.replace(/s$/, '');
          const item = specialItems[key];
          const factor = parsed.quantity;
          totalCal += item.cal * factor;
          totalProtein += item.protein * factor;
          totalCarbs += item.carbs * factor;
          totalFat += item.fat * factor;
          found = true;
          matched++;
        } else {
          for (const [key, value] of Object.entries(foodDB)) {
            if (name.includes(key) || key.includes(name)) {
              let qty = parsed.quantity;
              const unit = parsed.unit;
              if (unit === 'kg') qty = qty * 1000;
              else if (unit === 'oz') qty = qty * 28.35;
              else if (unit === 'lb') qty = qty * 453.6;
              else if (unit === 'count' || unit === '') {
                if (name.includes('tomato')) qty = qty * 150;
                else if (name.includes('onion')) qty = qty * 150;
                else if (name.includes('garlic')) qty = qty * 5;
                else qty = 100;
              }
              const factor = qty / 100;
              totalCal += value.cal * factor;
              totalProtein += value.protein * factor;
              totalCarbs += value.carbs * factor;
              totalFat += value.fat * factor;
              found = true;
              matched++;
              break;
            }
          }
        }

        if (!found) {
          if (name.includes('oil') || name.includes('butter')) {
            totalCal += 800; totalFat += 90;
          } else if (name.includes('meat') || name.includes('chicken') || name.includes('beef')) {
            totalCal += 200; totalProtein += 25; totalFat += 10;
          } else if (name.includes('flour') || name.includes('sugar') || name.includes('rice') || name.includes('pasta')) {
            totalCal += 130; totalCarbs += 25;
          } else {
            totalCal += 50; totalCarbs += 5; totalProtein += 1;
          }
        }
      });

      macroCal.value = Math.round(totalCal);
      macroProtein.value = Math.round(totalProtein * 10) / 10;
      macroCarbs.value = Math.round(totalCarbs * 10) / 10;
      macroFat.value = Math.round(totalFat * 10) / 10;

      autoProgress.textContent = matched > 0 ? `✅ ${matched} ingredients matched` : '⚠️ Manual adjustment recommended';
      setTimeout(() => { autoProgress.textContent = ''; }, 3000);
    }, 100);
  }

